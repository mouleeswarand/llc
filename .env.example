# Neon-managed — written by `neon deploy` / `neon env pull` from neon.ts. Don't edit by hand.
DATABASE_URL=            # pooled, used by the app
DATABASE_URL_UNPOOLED=   # direct, used by Prisma Migrate
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# App settings
# Signs Neon Auth session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
# Optional: AI Gateway model for name suggestions (default claude-haiku-4-5)
AI_MODEL=
